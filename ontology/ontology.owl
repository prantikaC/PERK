  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#memberOf">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://schema.org/memberOf"/>
    </rdfs:subPropertyOf>
