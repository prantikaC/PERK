      <rdf:Description rdf:about="https://w3id.org/perkonto#Method"/>
      <rdf:Description rdf:about="https://w3id.org/perkonto#Metric"/>
      <rdf:Description rdf:about="https://w3id.org/perkonto#Organization"/>
      <rdf:Description rdf:about="https://w3id.org/perkonto#Paper"/>
      <rdf:Description rdf:about="https://w3id.org/perkonto#PaperBib"/>
