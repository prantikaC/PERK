        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
    <rdfs:comment xml:lang="en">Links a Person to a Meeting or Conference they attend.</rdfs:comment>
    <rdfs:label xml:lang="en">attends</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#mergedFrom">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Record of the raw candidate node identifier(s) fused into  this canonical entity during entity resolution.</rdfs:comment>
    <rdfs:label xml:lang="en">merged from</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#affiliation">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://schema.org/affiliation"/>
    </rdfs:subPropertyOf>
    <rdfs:domain>
      <owl:Class rdf:nodeID="nb5a04507968a40e189fad8353a2c3ac8b1">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/perkonto#Person"/>
          <rdf:Description rdf:about="https://w3id.org/perkonto#Team"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:nodeID="nb5a04507968a40e189fad8353a2c3ac8b4">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/perkonto#Organization"/>
          <rdf:Description rdf:about="https://w3id.org/perkonto#Journal"/>
          <rdf:Description rdf:about="https://w3id.org/perkonto#Conference"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
    <rdfs:comment xml:lang="en">Links a Person or Team to the Organization, Journal, or  Conference they are affiliated with.</rdfs:comment>
    <rdfs:label xml:lang="en">affiliation</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#issue">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/ontology/bibo/issue"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#PaperBib"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">issue</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#mailNum">
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Email"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">A unique integer identifier for an Email.</rdfs:comment>
    <rdfs:label xml:lang="en">mail number</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#volume">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/ontology/bibo/volume"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#PaperBib"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">volume</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#usedFor">
    <rdfs:subPropertyOf rdf:resource="https://schema.org/isRelatedTo"/>
    <rdfs:domain>
      <owl:Class rdf:nodeID="nb5a04507968a40e189fad8353a2c3ac8b24">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/perkonto#Dataset"/>
          <rdf:Description rdf:about="https://w3id.org/perkonto#Method"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://w3id.org/perkonto#Task"/>
    <rdfs:comment xml:lang="en">Links a Dataset or Method to the Task it is applied to.</rdfs:comment>
    <rdfs:label xml:lang="en">used for</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#context">
    <rdfs:comment xml:lang="en">A free-text quote or paraphrase from the source email  substantiating the relationship it is attached to.</rdfs:comment>
    <rdfs:label xml:lang="en">context</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#mailDate">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="https://schema.org/dateCreated"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Email"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">The date on which the Email was sent.</rdfs:comment>
    <rdfs:label xml:lang="en">mail date</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#identifies">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/references"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#SubmissionID"/>
    <rdfs:range rdf:resource="https://w3id.org/perkonto#Paper"/>
    <rdfs:comment xml:lang="en">Links a SubmissionID to the Paper it identifies.</rdfs:comment>
    <rdfs:label xml:lang="en">identifies</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#taskName">
    <rdfs:subPropertyOf rdf:resource="https://schema.org/name"/>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Task"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">task name</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#confVenue">
    <rdfs:subPropertyOf rdf:resource="https://schema.org/location"/>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Conference"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">conference venue</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#metricName">
    <rdfs:subPropertyOf rdf:resource="https://schema.org/name"/>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Metric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">metric name</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#eID">
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#EmailID"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The email address string identifying this EmailID.</rdfs:comment>
    <rdfs:label xml:lang="en">email ID</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://w3id.org/perkonto">
    <owl:versionIRI rdf:resource="https://w3id.org/perkonto/1.0.1"/>
    <owl:imports rdf:resource="http://purl.org/ontology/bibo/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
    <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <dcterms:creator>Anonymous Authors</dcterms:creator>
    <dcterms:description xml:lang="en">A domain-specific ontology for representing the professional  knowledge of a researcher as extractable from personal email  communications. PERKOnto models communication infrastructure, researchers and venues, the publication lifecycle, and research content,  anchoring every assertion to its provenance email.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:title xml:lang="en">PERKOnto: Personal Email Research Knowledge Ontology</dcterms:title>
    <rdfs:seeAlso rdf:resource="urn:withheld-for-review"/>
    <owl:versionInfo>1.0.1</owl:versionInfo>
  </owl:Ontology>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#statusDate">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#generatedAtTime"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#PaperStatus"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">The date on which this status was recorded.</rdfs:comment>
    <rdfs:label xml:lang="en">status date</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#version">
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#PaperBib"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Version string of the manuscript (e.g. arXiv v2).</rdfs:comment>
    <rdfs:label xml:lang="en">version</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#uses">
    <rdfs:subPropertyOf rdf:resource="https://schema.org/isRelatedTo"/>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Method"/>
    <rdfs:range rdf:resource="https://w3id.org/perkonto#Dataset"/>
    <rdfs:comment xml:lang="en">Links a Method to a Dataset it is trained or evaluated  on.</rdfs:comment>
    <rdfs:label xml:lang="en">uses</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#mergeConfidence">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">Confidence score for an entity-resolution merge  decision.</rdfs:comment>
    <rdfs:label xml:lang="en">merge confidence</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#role">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The role held (e.g. PhD Scholar, Professor) as attested by a  memberOf or affiliation relationship.</rdfs:comment>
    <rdfs:label xml:lang="en">role</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#arxivID">
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#PaperBib"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">arXiv ID</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#partOf">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isPartOf"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Email"/>
    <rdfs:range rdf:resource="https://w3id.org/perkonto#MailThread"/>
    <rdfs:comment xml:lang="en">Links an Email to the MailThread it belongs to.</rdfs:comment>
    <rdfs:label xml:lang="en">part of</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#confTitle">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#hasAuthor">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.org/ontology/bibo/authorList"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Paper"/>
    <rdfs:range rdf:resource="https://w3id.org/perkonto#Person"/>
    <rdfs:comment xml:lang="en">Links a Paper to one of its author Persons.</rdfs:comment>
    <rdfs:label xml:lang="en">has author</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#teamName">
    <rdfs:subPropertyOf rdf:resource="https://schema.org/name"/>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Team"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">team name</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#hasPaperInfo">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://schema.org/subjectOf"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Paper"/>
    <rdfs:range rdf:resource="https://w3id.org/perkonto#PaperBib"/>
    <rdfs:comment xml:lang="en">Links a Paper to its bibliographic record.</rdfs:comment>
    <rdfs:label xml:lang="en">has paper info</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#receivedBy">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://schema.org/recipient"/>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#Email"/>
    <rdfs:range rdf:resource="https://w3id.org/perkonto#Person"/>
    <rdfs:comment xml:lang="en">Links an Email to the Person(s) who received it.</rdfs:comment>
    <rdfs:label xml:lang="en">received by</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#statusType">
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#PaperStatus"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The submission state label, e.g. 'Submitted',  'Under Review', 'Revision Required', 'Accepted', 'Rejected'.</rdfs:comment>
    <rdfs:label xml:lang="en">status type</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#identifier">
    <rdfs:domain rdf:resource="https://w3id.org/perkonto#SubmissionID"/>
  </owl:DatatypeProperty>
