@prefix : <https://w3id.org/perkonto/molbio#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/perkonto/molbio#> .

<https://w3id.org/perkonto/molbio> rdf:type owl:Ontology ;
                                    owl:imports <https://w3id.org/perkonto> ;
                                    <http://purl.org/dc/terms/creator> "Anonymous Authors" ;
                                    <http://purl.org/dc/terms/description> "A domain extension of PERKOnto for the professional knowledge of a molecular biologist as extractable from personal email communications. It reuses the PERKOnto backbone and specialises the scientific layer into experimental-biology concepts (BiologicalEntity/BiologicalSample/ExperimentalTechnique/Readout/ResearchProblem) plus supporting concepts (Reagent, Instrument, Protocol)."@en ;
                                    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                    <http://purl.org/dc/terms/title> "PERKOnto-MolBio: Molecular Biology extension of PERKOnto"@en ;
                                    owl:versionInfo "1.0.0" .

