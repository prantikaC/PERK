    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#AnalysisMethod</IRI>
        <Literal xml:lang="en">A technique applied to sources/data, e.g. matched filtering, Bayesian parameter estimation, numerical relativity simulation, unmodeled burst search.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#AnalysisMethod</IRI>
        <Literal xml:lang="en">Analysis Method</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#AnalysisMethod</IRI>
        <Literal xml:lang="en">Grounded in perk:Method only; no single widely-adopted community class for a GW analysis method exists.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#AnalysisPipeline</IRI>
        <Literal xml:lang="en">A software pipeline used to run an analysis method, e.g. PyCBC, gstLAL, Bilby, LALSuite.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#AnalysisPipeline</IRI>
        <Literal xml:lang="en">Analysis Pipeline / Software</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#AnalysisPipeline</IRI>
        <Literal xml:lang="en">Grounded in schema:SoftwareApplication.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#AstrophysicalSource</IRI>
        <Literal xml:lang="en">The physical system emitting gravitational radiation under study, e.g. a binary black hole, binary neutron star, supernova, or continuous-wave source.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#AstrophysicalSource</IRI>
        <Literal xml:lang="en">Astrophysical Source</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#AstrophysicalSource</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Dataset for the PERKOnto object-of-study role; ivoa:AstrObject (IVOA Ontology of Astronomical Object Types, &apos;Astronomical Object&apos;) for the astronomy standard.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Detector</IRI>
        <Literal xml:lang="en">A gravitational-wave detector or observatory that records data, e.g. LIGO Hanford, LIGO Livingston, Virgo, KAGRA, LISA.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Detector</IRI>
        <Literal xml:lang="en">Detector / Observatory</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#Detector</IRI>
        <Literal xml:lang="en">Grounded in obo:OBI_0000968 (OBI &apos;device&apos;): a detector is an instrument that produces data; OBI device is the closest cross-domain standard.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ObservationalData</IRI>
        <Literal xml:lang="en">A concrete analysed data artifact: detector strain segments, an event catalog (e.g. GWTC), or a numerical-relativity waveform catalog.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ObservationalData</IRI>
        <Literal xml:lang="en">Observational / Simulation Data</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#ObservationalData</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Dataset and obo:IAO_0000030 (IAO &apos;information content entity&apos;) for the data-artifact sense.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PhysicalParameter</IRI>
        <Literal xml:lang="en">A measured or inferred physical quantity, e.g. component masses, spins, luminosity distance, signal-to-noise ratio, false-alarm rate, sky localisation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#PhysicalParameter</IRI>
        <Literal xml:lang="en">Physical Parameter / Observable</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#PhysicalParameter</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Metric for the PERKOnto evaluative role; qudt:Quantity (QUDT) for the physical-quantity standard.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">A scientific question the group works on, e.g. &apos;test general relativity in the strong-field regime&apos;, &apos;measure the Hubble constant from standard sirens&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">Research Problem</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">Grounded in perk:Task only.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#WaveformModel</IRI>
        <Literal xml:lang="en">A signal model / template family used in analysis, e.g. effective-one-body (EOB), phenomenological (IMRPhenom), surrogate, or numerical-relativity template banks.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#WaveformModel</IRI>
        <Literal xml:lang="en">Waveform Model</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#analyses</IRI>
        <Literal xml:lang="en">Links an AnalysisMethod to the ObservationalData or AstrophysicalSource it is applied to. Specialises perk:uses.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#analyses</IRI>
        <Literal xml:lang="en">analyses</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#appliedToProblem</IRI>
        <Literal xml:lang="en">Links an AnalysisMethod or AstrophysicalSource to the ResearchProblem it addresses. Specialises perk:usedFor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#appliedToProblem</IRI>
        <Literal xml:lang="en">applied to problem</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#appliesMethod</IRI>
        <Literal xml:lang="en">Links a Person to an AnalysisMethod they use. Specialises perk:worksWith.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#appliesMethod</IRI>
        <Literal xml:lang="en">applies method</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#catalogName</IRI>
        <Literal xml:lang="en">Name of an event or waveform catalog, e.g. &apos;GWTC-3&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#catalogName</IRI>
        <Literal xml:lang="en">catalog name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#detectorName</IRI>
        <Literal xml:lang="en">detector name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#implementedIn</IRI>
        <Literal xml:lang="en">Links an AnalysisMethod to the AnalysisPipeline used to run it.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#implementedIn</IRI>
        <Literal xml:lang="en">implemented in</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#investigates</IRI>
        <Literal xml:lang="en">Links a Person to a ResearchProblem they work on. Specialises perk:worksOn.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#investigates</IRI>
        <Literal xml:lang="en">investigates</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#measures</IRI>
        <Literal xml:lang="en">Links a PhysicalParameter to the AstrophysicalSource, AnalysisMethod, or ResearchProblem it characterises. Specialises perk:evaluates.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#measures</IRI>
        <Literal xml:lang="en">measures</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#methodName</IRI>
        <Literal xml:lang="en">method name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#parameterName</IRI>
        <Literal xml:lang="en">Name of the physical parameter, e.g. &apos;chirp mass&apos;, &apos;SNR&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#parameterName</IRI>
        <Literal xml:lang="en">parameter name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#parameterUnit</IRI>
        <Literal xml:lang="en">Unit of the parameter, e.g. &apos;solar mass&apos;, &apos;Mpc&apos;, &apos;Hz&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#parameterUnit</IRI>
        <Literal xml:lang="en">parameter unit</Literal>
    </AnnotationAssertion>
