    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ChemicalSystem</IRI>
        <Literal xml:lang="en">The physical/molecular system under study: a molecule, complex, material, or assembly (e.g. a copper-trafficking protein, a soft-matter aggregate, a bioinorganic active site).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ChemicalSystem</IRI>
        <Literal xml:lang="en">Chemical System</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#ChemicalSystem</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Dataset gives the PERKOnto object-of-study role for cross-domain queries; obo:CHEBI_24431 (ChEBI &apos;chemical entity&apos;) gives the discipline-standard grounding.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ComputationalMethod</IRI>
        <Literal xml:lang="en">A simulation or theoretical technique applied to a chemical system, e.g. molecular dynamics, Monte Carlo, density functional theory, enhanced sampling, coarse-grained modelling.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ComputationalMethod</IRI>
        <Literal xml:lang="en">Computational Method</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#ComputationalMethod</IRI>
        <Literal xml:lang="en">Grounded in perk:Method only: no single widely-adopted community class for a computational-chemistry method exists; perk:Method already aligns to schema:SoftwareApplication upstream.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ForceField</IRI>
        <Literal xml:lang="en">A parameter set defining interatomic interactions used by a (classical) simulation method, e.g. CHARMM, AMBER, OPLS, or a custom coarse-grained model.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ForceField</IRI>
        <Literal xml:lang="en">Force Field</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LevelOfTheory</IRI>
        <Literal xml:lang="en">The theoretical/basis-set specification for an electronic-structure calculation, e.g. &apos;B3LYP/6-31G*&apos;, &apos;CCSD(T)/cc-pVTZ&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LevelOfTheory</IRI>
        <Literal xml:lang="en">Level of Theory</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Observable</IRI>
        <Literal xml:lang="en">A physical quantity computed or measured from a simulation/calculation, e.g. free energy, binding affinity, radial distribution function, diffusion coefficient, reaction barrier.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Observable</IRI>
        <Literal xml:lang="en">Observable / Computed Property</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#Observable</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Metric for the PERKOnto evaluative role; qudt:Quantity (QUDT) for the physical-quantity standard.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">A scientific question or problem formulation the group works on, e.g. &apos;mechanism of copper trafficking&apos;, &apos;self-assembly in soft matter&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">Research Problem</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">Grounded in perk:Task only; perk:Task aligns to schema:Action upstream.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Software</IRI>
        <Literal xml:lang="en">A software package or code used to run a computational method, e.g. GROMACS, LAMMPS, NAMD, Gaussian, ORCA.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Software</IRI>
        <Literal xml:lang="en">Simulation Software / Package</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#Software</IRI>
        <Literal xml:lang="en">Grounded in schema:SoftwareApplication (the same upstream class perk:Method uses).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#appliedToProblem</IRI>
        <Literal xml:lang="en">Links a ComputationalMethod or ChemicalSystem to the ResearchProblem it addresses. Specialises perk:usedFor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#appliedToProblem</IRI>
        <Literal xml:lang="en">applied to problem</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#appliesMethod</IRI>
        <Literal xml:lang="en">Links a Person to a ComputationalMethod they use. Specialises perk:worksWith.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#appliesMethod</IRI>
        <Literal xml:lang="en">applies method</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#atLevelOfTheory</IRI>
        <Literal xml:lang="en">Links an electronic-structure ComputationalMethod to its LevelOfTheory.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#atLevelOfTheory</IRI>
        <Literal xml:lang="en">at level of theory</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#forceFieldName</IRI>
        <Literal xml:lang="en">force field name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#implementedIn</IRI>
        <Literal xml:lang="en">Links a ComputationalMethod to the Software package used to run it.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#implementedIn</IRI>
        <Literal xml:lang="en">implemented in</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#investigates</IRI>
        <Literal xml:lang="en">Links a Person to a ResearchProblem they work on. Specialises perk:worksOn.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#investigates</IRI>
        <Literal xml:lang="en">investigates</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#methodName</IRI>
        <Literal xml:lang="en">Name of the computational method (e.g. &apos;molecular dynamics&apos;, &apos;DFT&apos;).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#methodName</IRI>
        <Literal xml:lang="en">method name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#observableName</IRI>
        <Literal xml:lang="en">Name of the physical observable (e.g. &apos;free energy&apos;).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#observableName</IRI>
        <Literal xml:lang="en">observable name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#observableUnit</IRI>
        <Literal xml:lang="en">Physical unit of the observable value (e.g. &apos;kcal/mol&apos;).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#observableUnit</IRI>
        <Literal xml:lang="en">observable unit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#observableValue</IRI>
        <Literal xml:lang="en">Reported numeric value of an observable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#observableValue</IRI>
        <Literal xml:lang="en">observable value</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#quantifies</IRI>
        <Literal xml:lang="en">Links an Observable to the ComputationalMethod, ChemicalSystem, or ResearchProblem it characterises. Specialises perk:evaluates.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#quantifies</IRI>
        <Literal xml:lang="en">quantifies</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#simulates</IRI>
        <Literal xml:lang="en">Links a ComputationalMethod to the ChemicalSystem it is applied to. Specialises perk:uses.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#simulates</IRI>
        <Literal xml:lang="en">simulates</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#smiles</IRI>
        <Literal xml:lang="en">SMILES string encoding the molecular structure, where applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#smiles</IRI>
        <Literal xml:lang="en">SMILES</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#softwareName</IRI>
        <Literal xml:lang="en">software name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#softwareVersion</IRI>
        <Literal xml:lang="en">software version</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#studies</IRI>
        <Literal xml:lang="en">Links a Person to a ChemicalSystem they investigate. Specialises perk:worksWith.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#studies</IRI>
        <Literal xml:lang="en">studies</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#systemName</IRI>
        <Literal xml:lang="en">Name or identifier of the chemical system studied.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#systemName</IRI>
        <Literal xml:lang="en">system name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#usesForceField</IRI>
        <Literal xml:lang="en">Links a ComputationalMethod to the ForceField that parameterises it.</Literal>
