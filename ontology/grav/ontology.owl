<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/perkonto/grav#"
     xml:base="https://w3id.org/perkonto/grav"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/perkonto/grav">
        <owl:imports rdf:resource="https://w3id.org/perkonto"/>
        <terms:creator>Anonymous Author</terms:creator>
        <terms:creator>Anonymous Author</terms:creator>
        <terms:creator>Anonymous Author</terms:creator>
        <terms:creator>Anonymous Author</terms:creator>
        <terms:description xml:lang="en">A domain extension of PERKOnto for the professional knowledge of a gravitational-wave / relativity physicist as extractable from personal email communications. It reuses the PERKOnto backbone and specialises the scientific layer into gravitational-physics concepts (AstrophysicalSource/ObservationalData/AnalysisMethod/PhysicalParameter/ResearchProblem) plus supporting concepts (Detector, WaveformModel, AnalysisPipeline).</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">PERKOnto-Grav: Gravitational Physics extension of PERKOnto</terms:title>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/perkonto#evaluates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#evaluates"/>
    


    <!-- https://w3id.org/perkonto#usedFor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#usedFor"/>
    


    <!-- https://w3id.org/perkonto#uses -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#uses"/>
    


    <!-- https://w3id.org/perkonto#worksOn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#worksOn"/>
    


    <!-- https://w3id.org/perkonto#worksWith -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto#worksWith"/>
    


    <!-- https://w3id.org/perkonto/grav#analyses -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#analyses">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#uses"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#AnalysisMethod"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/perkonto/grav#AstrophysicalSource"/>
                    <rdf:Description rdf:about="https://w3id.org/perkonto/grav#ObservationalData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links an AnalysisMethod to the ObservationalData or AstrophysicalSource it is applied to. Specialises perk:uses.</rdfs:comment>
        <rdfs:label xml:lang="en">analyses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/grav#appliedToProblem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#appliedToProblem">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#usedFor"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/perkonto/grav#AnalysisMethod"/>
                    <rdf:Description rdf:about="https://w3id.org/perkonto/grav#AstrophysicalSource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/grav#ResearchProblem"/>
        <rdfs:comment xml:lang="en">Links an AnalysisMethod or AstrophysicalSource to the ResearchProblem it addresses. Specialises perk:usedFor.</rdfs:comment>
        <rdfs:label xml:lang="en">applied to problem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/grav#appliesMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#appliesMethod">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#worksWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/grav#AnalysisMethod"/>
        <rdfs:comment xml:lang="en">Links a Person to an AnalysisMethod they use. Specialises perk:worksWith.</rdfs:comment>
        <rdfs:label xml:lang="en">applies method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/grav#implementedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#implementedIn">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#AnalysisMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/grav#AnalysisPipeline"/>
        <rdfs:comment xml:lang="en">Links an AnalysisMethod to the AnalysisPipeline used to run it.</rdfs:comment>
        <rdfs:label xml:lang="en">implemented in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/grav#investigates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#investigates">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#worksOn"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/grav#ResearchProblem"/>
        <rdfs:comment xml:lang="en">Links a Person to a ResearchProblem they work on. Specialises perk:worksOn.</rdfs:comment>
        <rdfs:label xml:lang="en">investigates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/grav#measures -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#measures">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#evaluates"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#PhysicalParameter"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/perkonto/grav#AnalysisMethod"/>
                    <rdf:Description rdf:about="https://w3id.org/perkonto/grav#AstrophysicalSource"/>
                    <rdf:Description rdf:about="https://w3id.org/perkonto/grav#ResearchProblem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links a PhysicalParameter to the AstrophysicalSource, AnalysisMethod, or ResearchProblem it characterises. Specialises perk:evaluates.</rdfs:comment>
        <rdfs:label xml:lang="en">measures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/grav#recordedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#recordedBy">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#ObservationalData"/>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/grav#Detector"/>
        <rdfs:comment xml:lang="en">Links ObservationalData to the Detector that recorded it.</rdfs:comment>
        <rdfs:label xml:lang="en">recorded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/grav#studies -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#studies">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#worksWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/grav#AstrophysicalSource"/>
        <rdfs:comment xml:lang="en">Links a Person to an AstrophysicalSource they investigate. Specialises perk:worksWith.</rdfs:comment>
        <rdfs:label xml:lang="en">studies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/grav#usesWaveformModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/grav#usesWaveformModel">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#AnalysisMethod"/>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/grav#WaveformModel"/>
        <rdfs:comment xml:lang="en">Links an AnalysisMethod to the WaveformModel / template family it uses.</rdfs:comment>
        <rdfs:label xml:lang="en">uses waveform model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/perkonto#datasetName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#datasetName"/>
    


    <!-- https://w3id.org/perkonto#methodName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#methodName"/>
    


    <!-- https://w3id.org/perkonto#metricName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#metricName"/>
    


    <!-- https://w3id.org/perkonto#version -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto#version"/>
    


    <!-- https://w3id.org/perkonto/grav#catalogName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#catalogName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#datasetName"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#ObservationalData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of an event or waveform catalog, e.g. &apos;GWTC-3&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">catalog name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#detectorName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#detectorName">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#Detector"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">detector name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#methodName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#methodName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#methodName"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#AnalysisMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">method name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#parameterName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#parameterName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#metricName"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#PhysicalParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the physical parameter, e.g. &apos;chirp mass&apos;, &apos;SNR&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">parameter name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#parameterUnit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#parameterUnit">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#PhysicalParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unit of the parameter, e.g. &apos;solar mass&apos;, &apos;Mpc&apos;, &apos;Hz&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">parameter unit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#parameterValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#parameterValue">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#PhysicalParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">parameter value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#pipelineName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#pipelineName">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#AnalysisPipeline"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">pipeline name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#pipelineVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#pipelineVersion">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#version"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#AnalysisPipeline"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">pipeline version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#sourceName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#sourceName">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#datasetName"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#AstrophysicalSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Designation of the astrophysical source / event, e.g. &apos;GW150914&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">source name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#sourceType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#sourceType">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#AstrophysicalSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Category of source, e.g. &apos;BBH&apos;, &apos;BNS&apos;, &apos;NSBH&apos;, &apos;supernova&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">source type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/perkonto/grav#waveformModelName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/perkonto/grav#waveformModelName">
        <rdfs:domain rdf:resource="https://w3id.org/perkonto/grav#WaveformModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">waveform model name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030"/>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000968 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000968"/>
    


    <!-- http://purl.org/astronomy/ont/object-types#AstrObject -->


    <owl:Class rdf:about="http://purl.org/astronomy/ont/object-types#AstrObject"/>
    


    <!-- http://qudt.org/schema/qudt/Quantity -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Quantity"/>
    


    <!-- https://schema.org/SoftwareApplication -->


    <owl:Class rdf:about="https://schema.org/SoftwareApplication"/>
    


    <!-- https://w3id.org/perkonto#Dataset -->


    <owl:Class rdf:about="https://w3id.org/perkonto#Dataset"/>
    


    <!-- https://w3id.org/perkonto#Method -->


    <owl:Class rdf:about="https://w3id.org/perkonto#Method"/>
    


    <!-- https://w3id.org/perkonto#Metric -->


    <owl:Class rdf:about="https://w3id.org/perkonto#Metric"/>
    


    <!-- https://w3id.org/perkonto#Person -->


    <owl:Class rdf:about="https://w3id.org/perkonto#Person"/>
    


    <!-- https://w3id.org/perkonto#Task -->


    <owl:Class rdf:about="https://w3id.org/perkonto#Task"/>
    


    <!-- https://w3id.org/perkonto/grav#AnalysisMethod -->


    <owl:Class rdf:about="https://w3id.org/perkonto/grav#AnalysisMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/perkonto#Method"/>
        <rdfs:comment xml:lang="en">A technique applied to sources/data, e.g. matched filtering, Bayesian parameter estimation, numerical relativity simulation, unmodeled burst search.</rdfs:comment>
        <rdfs:label xml:lang="en">Analysis Method</rdfs:label>
        <skos:note xml:lang="en">Grounded in perk:Method only; no single widely-adopted community class for a GW analysis method exists.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/perkonto/grav#AnalysisPipeline -->


    <owl:Class rdf:about="https://w3id.org/perkonto/grav#AnalysisPipeline">
        <rdfs:subClassOf rdf:resource="https://schema.org/SoftwareApplication"/>
        <rdfs:comment xml:lang="en">A software pipeline used to run an analysis method, e.g. PyCBC, gstLAL, Bilby, LALSuite.</rdfs:comment>
        <rdfs:label xml:lang="en">Analysis Pipeline / Software</rdfs:label>
        <skos:note xml:lang="en">Grounded in schema:SoftwareApplication.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/perkonto/grav#AstrophysicalSource -->


    <owl:Class rdf:about="https://w3id.org/perkonto/grav#AstrophysicalSource">
        <rdfs:subClassOf rdf:resource="http://purl.org/astronomy/ont/object-types#AstrObject"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/perkonto#Dataset"/>
        <rdfs:comment xml:lang="en">The physical system emitting gravitational radiation under study, e.g. a binary black hole, binary neutron star, supernova, or continuous-wave source.</rdfs:comment>
        <rdfs:label xml:lang="en">Astrophysical Source</rdfs:label>
        <skos:note xml:lang="en">Dual-grounded: perk:Dataset for the PERKOnto object-of-study role; ivoa:AstrObject (IVOA Ontology of Astronomical Object Types, &apos;Astronomical Object&apos;) for the astronomy standard.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/perkonto/grav#Detector -->


    <owl:Class rdf:about="https://w3id.org/perkonto/grav#Detector">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <rdfs:comment xml:lang="en">A gravitational-wave detector or observatory that records data, e.g. LIGO Hanford, LIGO Livingston, Virgo, KAGRA, LISA.</rdfs:comment>
        <rdfs:label xml:lang="en">Detector / Observatory</rdfs:label>
        <skos:note xml:lang="en">Grounded in obo:OBI_0000968 (OBI &apos;device&apos;): a detector is an instrument that produces data; OBI device is the closest cross-domain standard.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/perkonto/grav#ObservationalData -->


    <owl:Class rdf:about="https://w3id.org/perkonto/grav#ObservationalData">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/perkonto#Dataset"/>
        <rdfs:comment xml:lang="en">A concrete analysed data artifact: detector strain segments, an event catalog (e.g. GWTC), or a numerical-relativity waveform catalog.</rdfs:comment>
        <rdfs:label xml:lang="en">Observational / Simulation Data</rdfs:label>
        <skos:note xml:lang="en">Dual-grounded: perk:Dataset and obo:IAO_0000030 (IAO &apos;information content entity&apos;) for the data-artifact sense.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/perkonto/grav#PhysicalParameter -->


    <owl:Class rdf:about="https://w3id.org/perkonto/grav#PhysicalParameter">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/perkonto#Metric"/>
        <rdfs:comment xml:lang="en">A measured or inferred physical quantity, e.g. component masses, spins, luminosity distance, signal-to-noise ratio, false-alarm rate, sky localisation.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Parameter / Observable</rdfs:label>
        <skos:note xml:lang="en">Dual-grounded: perk:Metric for the PERKOnto evaluative role; qudt:Quantity (QUDT) for the physical-quantity standard.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/perkonto/grav#ResearchProblem -->


    <owl:Class rdf:about="https://w3id.org/perkonto/grav#ResearchProblem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/perkonto#Task"/>
        <rdfs:comment xml:lang="en">A scientific question the group works on, e.g. &apos;test general relativity in the strong-field regime&apos;, &apos;measure the Hubble constant from standard sirens&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Problem</rdfs:label>
        <skos:note xml:lang="en">Grounded in perk:Task only.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/perkonto/grav#WaveformModel -->


    <owl:Class rdf:about="https://w3id.org/perkonto/grav#WaveformModel">
        <rdfs:comment xml:lang="en">A signal model / template family used in analysis, e.g. effective-one-body (EOB), phenomenological (IMRPhenom), surrogate, or numerical-relativity template banks.</rdfs:comment>
        <rdfs:label xml:lang="en">Waveform Model</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/perkonto/grav#AnalysisMethod"/>
            <rdf:Description rdf:about="https://w3id.org/perkonto/grav#AnalysisPipeline"/>
            <rdf:Description rdf:about="https://w3id.org/perkonto/grav#AstrophysicalSource"/>
            <rdf:Description rdf:about="https://w3id.org/perkonto/grav#Detector"/>
            <rdf:Description rdf:about="https://w3id.org/perkonto/grav#ObservationalData"/>
            <rdf:Description rdf:about="https://w3id.org/perkonto/grav#PhysicalParameter"/>
            <rdf:Description rdf:about="https://w3id.org/perkonto/grav#ResearchProblem"/>
            <rdf:Description rdf:about="https://w3id.org/perkonto/grav#WaveformModel"/>
        </owl:members>
    </rdf:Description>
</rdf:RDF>



