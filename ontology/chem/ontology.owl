        <rdfs:domain rdf:resource="https://w3id.org/perkonto#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/chem#ChemicalSystem"/>
        <rdfs:comment xml:lang="en">Links a Person to a ChemicalSystem they investigate. Specialises perk:worksWith.</rdfs:comment>
        <rdfs:label xml:lang="en">studies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/chem#usesForceField -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/chem#usesForceField">
