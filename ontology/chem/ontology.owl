        <rdfs:range rdf:resource="https://w3id.org/perkonto/chem#LevelOfTheory"/>
        <rdfs:comment xml:lang="en">Links an electronic-structure ComputationalMethod to its LevelOfTheory.</rdfs:comment>
        <rdfs:label xml:lang="en">at level of theory</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/chem#implementedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/chem#implementedIn">
