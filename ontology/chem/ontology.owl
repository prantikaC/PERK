    <!-- https://w3id.org/perkonto/chem#appliedToProblem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/chem#appliedToProblem">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#usedFor"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/perkonto/chem#ChemicalSystem"/>
                    <rdf:Description rdf:about="https://w3id.org/perkonto/chem#ComputationalMethod"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/chem#ResearchProblem"/>
        <rdfs:comment xml:lang="en">Links a ComputationalMethod or ChemicalSystem to the ResearchProblem it addresses. Specialises perk:usedFor.</rdfs:comment>
        <rdfs:label xml:lang="en">applied to problem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/chem#appliesMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/chem#appliesMethod">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/perkonto#worksWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/perkonto#Person"/>
        <rdfs:range rdf:resource="https://w3id.org/perkonto/chem#ComputationalMethod"/>
        <rdfs:comment xml:lang="en">Links a Person to a ComputationalMethod they use. Specialises perk:worksWith.</rdfs:comment>
        <rdfs:label xml:lang="en">applies method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/perkonto/chem#atLevelOfTheory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/perkonto/chem#atLevelOfTheory">
