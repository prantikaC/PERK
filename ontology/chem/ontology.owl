    <owl:Ontology rdf:about="https://w3id.org/perkonto/chem">
        <owl:imports rdf:resource="https://w3id.org/perkonto"/>
        <terms:creator>Anonymous Author</terms:creator>
        <terms:creator>Anonymous Author</terms:creator>
        <terms:creator>Anonymous Author</terms:creator>
        <terms:creator>Anonymous Author</terms:creator>
        <terms:description xml:lang="en">A domain extension of PERKOnto for the professional knowledge of a computational/theoretical chemist as extractable from personal email communications. It reuses the PERKOnto communication, actor, venue and publication-lifecycle backbone and specialises the scientific layer (Dataset/Method/Metric/Task) into chemistry concepts (ChemicalSystem/ComputationalMethod/Observable/ResearchProblem) plus supporting concepts (ForceField, Software, LevelOfTheory).</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">PERKOnto-Chem: Computational Chemistry extension of PERKOnto</terms:title>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


