    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#BiologicalEntity</IRI>
        <Literal xml:lang="en">The biological object of study: a gene, protein, pathway, cell line, tissue, or organism (e.g. the p53 protein, E. coli, a HeLa cell line).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#BiologicalEntity</IRI>
        <Literal xml:lang="en">Biological Entity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#BiologicalEntity</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Dataset for the PERKOnto object-of-study role; obo:BFO_0000040 (BFO &apos;material entity&apos;), the OBO upper class that genes/proteins/cells specialise. More specific groundings (e.g. obo:SO_0000704 &apos;gene&apos;, obo:PR_* proteins) apply at the instance level.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#BiologicalSample</IRI>
        <Literal xml:lang="en">A concrete analysed artifact: a biological sample, a sequencing run, an image dataset, or a screen.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#BiologicalSample</IRI>
        <Literal xml:lang="en">Biological Sample / Generated Dataset</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#BiologicalSample</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Dataset and obo:OBI_0100051 (OBI &apos;specimen&apos;).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ExperimentalTechnique</IRI>
        <Literal xml:lang="en">A laboratory technique or assay applied, e.g. PCR, CRISPR-Cas9 editing, RNA sequencing, Western blot, mass spectrometry, confocal microscopy, flow cytometry.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ExperimentalTechnique</IRI>
        <Literal xml:lang="en">Experimental Technique / Assay</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#ExperimentalTechnique</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Method for the PERKOnto role; obo:OBI_0000070 (OBI &apos;assay&apos;) for the biomedical-investigation standard.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Instrument</IRI>
        <Literal xml:lang="en">A laboratory instrument or platform used to run a technique, e.g. an Illumina NovaSeq sequencer, a confocal microscope, a qPCR machine, a mass spectrometer.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Instrument</IRI>
        <Literal xml:lang="en">Instrument / Platform</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#Instrument</IRI>
        <Literal xml:lang="en">Grounded in obo:OBI_0000968 (OBI &apos;device&apos;).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Protocol</IRI>
        <Literal xml:lang="en">A documented experimental procedure / standard operating procedure followed to perform a technique.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Protocol</IRI>
        <Literal xml:lang="en">Protocol</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#Protocol</IRI>
        <Literal xml:lang="en">Grounded in obo:OBI_0000272 (OBI &apos;protocol&apos;).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Readout</IRI>
        <Literal xml:lang="en">A measured biological quantity or endpoint, e.g. gene-expression level, cell viability, binding affinity (Kd), fluorescence intensity, differential-expression p-value.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Readout</IRI>
        <Literal xml:lang="en">Readout / Measured Quantity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#Readout</IRI>
        <Literal xml:lang="en">Dual-grounded: perk:Metric and qudt:Quantity (QUDT).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Reagent</IRI>
        <Literal xml:lang="en">A consumable biological/chemical material used in an experiment, e.g. an antibody, primer, plasmid, enzyme, stain, or kit.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Reagent</IRI>
        <Literal xml:lang="en">Reagent / Material</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#Reagent</IRI>
        <Literal xml:lang="en">Grounded in obo:BFO_0000040 (BFO &apos;material entity&apos;); OBI models reagents as material entities.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">A scientific question or hypothesis the group works on, e.g. &apos;role of gene X in apoptosis&apos;, &apos;mechanism of copper trafficking in cells&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">Research Problem / Hypothesis</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:note"/>
        <IRI>#ResearchProblem</IRI>
        <Literal xml:lang="en">Grounded in perk:Task only.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#accessionID</IRI>
        <Literal xml:lang="en">Database accession identifier, e.g. a UniProt ID, GenBank accession, or SRA run ID.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#accessionID</IRI>
        <Literal xml:lang="en">accession ID</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#appliedToProblem</IRI>
        <Literal xml:lang="en">Links an ExperimentalTechnique or BiologicalEntity to the ResearchProblem it addresses. Specialises perk:usedFor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#appliedToProblem</IRI>
        <Literal xml:lang="en">applied to problem</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#appliesTechnique</IRI>
        <Literal xml:lang="en">Links a Person to an ExperimentalTechnique they use. Specialises perk:worksWith.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#appliesTechnique</IRI>
        <Literal xml:lang="en">applies technique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#assays</IRI>
        <Literal xml:lang="en">Links an ExperimentalTechnique to the BiologicalEntity or BiologicalSample it is applied to. Specialises perk:uses.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#assays</IRI>
        <Literal xml:lang="en">assays</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#entityName</IRI>
        <Literal xml:lang="en">Name of the biological entity, e.g. &apos;p53&apos;, &apos;E. coli K-12&apos;, &apos;HeLa&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#entityName</IRI>
        <Literal xml:lang="en">entity name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#entityType</IRI>
        <Literal xml:lang="en">Category of entity, e.g. &apos;gene&apos;, &apos;protein&apos;, &apos;pathway&apos;, &apos;cell line&apos;, &apos;organism&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#entityType</IRI>
        <Literal xml:lang="en">entity type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#followsProtocol</IRI>
        <Literal xml:lang="en">Links an ExperimentalTechnique to the Protocol it follows.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#followsProtocol</IRI>
        <Literal xml:lang="en">follows protocol</Literal>
